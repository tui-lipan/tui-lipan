#!/usr/bin/env python3
"""Record raw PTY output for tests/fixtures/terminal-corpus/.

Each `<name>.vt` file is the byte stream a terminal emulator would read from
the PTY master (program output, plus the kernel echo of typed input). It is
not a later re-render. The matching `<name>.toml` gives the fixed size the
PTY was created at. No `[[ops]]` table means: write the whole stream, then dump.

The child runs with a neutral home and user. A fixture is refused when it
contains that home, the current user, host, or git email. A CPU model, memory
total, hostname, or kernel release is rewritten to a placeholder of the same
width. Re-run from the repo root:

    scripts/capture-terminal-corpus
    scripts/capture-terminal-corpus bash-color nvim-edit
    scripts/capture-terminal-corpus --check
"""

from __future__ import annotations

import argparse
import errno
import fcntl
import getpass
import os
import pty
import re
import select
import signal
import socket
import struct
import subprocess
import sys
import termios
import textwrap
import time
import tomllib
import unicodedata
from dataclasses import dataclass, field
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
OUT_DIR = REPO / "tests" / "fixtures" / "terminal-corpus"
WORK = Path("/tmp/w")
HOME = Path("/tmp/corpus-home")
RUN_DIR = Path("/tmp/corpus-run")
SCROLLBACK = 10000
MAX_FIXTURE_BYTES = 200 * 1024
MAX_CORPUS_BYTES = 3 * 1024 * 1024
_BINARY_UNITS = ("Byte", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB")
_DECIMAL_UNITS = ("Byte", "kB", "MB", "GB", "TB", "PB", "EB")

# Queries a real terminal answers. Programs such as nvim stall or warn when
# these go unanswered, so the capture replies the way a plain xterm would.
# Replies are written to the child; they are not added to the recorded stream.
_QUERY_PATTERNS: list[tuple[re.Pattern[bytes], object]] = [
    (re.compile(br"\x1b\]11;\?(?:\x07|\x1b\\)"), lambda _m: b"\x1b]11;rgb:0000/0000/0000\x07"),
    (re.compile(br"\x1b\]10;\?(?:\x07|\x1b\\)"), lambda _m: b"\x1b]10;rgb:ffff/ffff/ffff\x07"),
    (re.compile(br"\x1bP\+q[0-9A-Fa-f;]*\x1b\\"), lambda _m: b"\x1bP0+r\x1b\\"),
    (re.compile(br"\x1bP\$q[ -\x7e]*\x1b\\"), lambda _m: b"\x1bP0$r\x1b\\"),
    (re.compile(br"\x1b\[\?(\d+)\$p"), lambda m: b"\x1b[?" + m.group(1) + b";2$y"),
    (re.compile(br"\x1b\[\?u"), lambda _m: b"\x1b[?0u"),
    (re.compile(br"\x1b\[>[\d;]*c"), lambda _m: b"\x1b[>0;0;0c"),
    (re.compile(br"\x1b\[0?c"), lambda _m: b"\x1b[?1;2c"),
    (re.compile(br"\x1b\[5n"), lambda _m: b"\x1b[0n"),
    (re.compile(br"\x1b\[6n"), lambda _m: b"\x1b[1;1R"),
]


class CaptureError(RuntimeError):
    pass


class Responder:
    def __init__(self) -> None:
        self.buf = bytearray()

    def feed(self, data: bytes) -> bytes:
        self.buf += data
        replies: list[bytes] = []
        while True:
            blob = bytes(self.buf)
            best: tuple[int, int, bytes] | None = None
            for pattern, reply_of in _QUERY_PATTERNS:
                match = pattern.search(blob)
                if match is not None and (best is None or match.start() < best[0]):
                    best = (match.start(), match.end(), reply_of(match))
            if best is None:
                mark = blob.rfind(b"\x1b")
                if mark > 0:
                    del self.buf[:mark]
                elif mark < 0 and len(self.buf) > 128:
                    self.buf.clear()
                break
            del self.buf[: best[1]]
            replies.append(best[2])
        return b"".join(replies)


@dataclass
class Scenario:
    name: str
    rows: int
    cols: int
    description: str
    program: str
    argv: list[str]
    note: str
    expect: list[bytes]
    env: dict[str, str]
    cwd: Path
    steps: list[tuple] = field(default_factory=list)
    timeout: float = 10.0


def base_env() -> dict[str, str]:
    return {
        "PATH": "/usr/bin:/bin",
        "HOME": str(HOME),
        "USER": "user",
        "LOGNAME": "user",
        "USERNAME": "user",
        "HOSTNAME": "host",
        "SHELL": "/bin/bash",
        "TERM": "xterm-256color",
        "COLORTERM": "truecolor",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "XDG_CONFIG_HOME": str(HOME / ".config"),
        "XDG_CACHE_HOME": str(HOME / ".cache"),
        "XDG_DATA_HOME": str(HOME / ".local" / "share"),
        "XDG_STATE_HOME": str(HOME / ".local" / "state"),
        "XDG_RUNTIME_DIR": str(RUN_DIR),
        "HISTFILE": "/dev/null",
        "LESSHISTFILE": "/dev/null",
        "LESSHISTSIZE": "0",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONNOUSERSITE": "1",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": str(HOME / "gitconfig"),
        "GIT_CONFIG_SYSTEM": "/dev/null",
        "GIT_PAGER": "cat",
        "PAGER": "cat",
        "GIT_AUTHOR_NAME": "Ada Example",
        "GIT_AUTHOR_EMAIL": "ada@example.com",
        "GIT_COMMITTER_NAME": "Ada Example",
        "GIT_COMMITTER_EMAIL": "ada@example.com",
        "GIT_TEMPLATE_DIR": str(HOME / "git-template"),
    }


def command_line(argv: list[str]) -> str:
    return subprocess.list2cmdline(argv)


def first_line(argv: list[str], env: dict[str, str] | None = None) -> str:
    try:
        out = subprocess.check_output(
            argv,
            stderr=subprocess.STDOUT,
            env=env,
            text=True,
            timeout=15,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        return f"{argv[0]} (version unavailable: {exc})"
    line = out.strip().splitlines()
    return line[0] if line else argv[0]


def run_cmd(argv: list[str], cwd: Path, env: dict[str, str]) -> None:
    proc = subprocess.run(
        argv,
        cwd=cwd,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if proc.returncode != 0:
        detail = proc.stderr.decode("utf-8", "replace")[-800:]
        raise CaptureError(f"{argv!r} -> {proc.returncode}: {detail}")


def reset_tree(path: Path) -> None:
    if path.exists():
        subprocess.run(["rm", "-rf", str(path)], check=True)
    path.mkdir(parents=True)


def prepare_workspace(env: dict[str, str]) -> None:
    reset_tree(HOME)
    reset_tree(WORK)
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    for rel in (".config", ".cache", ".local/share", ".local/state", "git-template"):
        (HOME / rel).mkdir(parents=True, exist_ok=True)
    (HOME / "gitconfig").write_text(
        "\n".join(
            [
                "[user]",
                "    name = Ada Example",
                "    email = ada@example.com",
                "[init]",
                "    defaultBranch = main",
                "[commit]",
                "    gpgsign = false",
                "[color]",
                "    ui = always",
                "",
            ]
        ),
        encoding="utf-8",
    )
    (HOME / "corpus.bashrc").write_text(
        "PROMPT_COMMAND=\n"
        "PS1='\\[\\e[1;32m\\]user@host\\[\\e[0m\\]:\\[\\e[1;34m\\]\\w\\[\\e[0m\\]\\$ '\n",
        encoding="utf-8",
    )
    listing = WORK / "listing"
    listing.mkdir()
    (listing / "docs").mkdir()
    (listing / "docs" / "guide.txt").write_text("guide\n", encoding="utf-8")
    (listing / "README.md").write_text("sample readme\n", encoding="utf-8")
    (listing / "main.rs").write_text("fn main() {}\n", encoding="utf-8")
    (listing / "notes.txt").write_text("notes\n", encoding="utf-8")
    (listing / "very-long-sample-name.txt").write_text("name\n", encoding="utf-8")
    script = listing / "run.sh"
    script.write_text("#!/bin/sh\necho sample\n", encoding="utf-8")
    script.chmod(0o755)
    (listing / "link").symlink_to("docs")
    (listing / "missing").symlink_to("absent")

    lines = ["TOP-MARKER", "\x1b[31mRED-MARKER\x1b[0m", "\x1b[32mGREEN-MARKER\x1b[0m"]
    lines.append("wrap " + ("word " * 40))
    lines.append("café 😀 中文")
    lines.extend(f"row {index:03d} alpha beta gamma" for index in range(1, 28))
    lines.append("PAGE-TWO-MARKER")
    lines.extend(f"row {index:03d} alpha beta gamma" for index in range(28, 60))
    (WORK / "page.txt").write_text("\n".join(lines) + "\n", encoding="utf-8")

    sample = ["fn main() {", "    let values = [1, 2, 3, 4];", "    let mut total = 0;"]
    sample.append("    for value in values {")
    sample.append("        total += value;")
    sample.append("    }")
    sample.append('    println!("{total}");')
    sample.append("}")
    sample.extend(f"// sample line {index:03d} for scrolling" for index in range(1, 80))
    (WORK / "sample.rs").write_text("\n".join(sample) + "\n", encoding="utf-8")

    paragraphs = [
        ".TH DEMO 1 \"2026-01-15\" \"demo 1.0\" \"User Commands\"",
        ".SH NAME",
        "demo \\- show a page of neutral text",
        ".SH SYNOPSIS",
        ".B demo",
        "[\\fIOPTIONS\\fR]",
        ".SH DESCRIPTION",
        "A short manual page used as a terminal capture sample.",
        ".PP",
        "It has more than one screen of text so a pager can move.",
    ]
    for index in range(1, 14):
        paragraphs.append(".PP")
        paragraphs.append(f"Neutral paragraph {index:02d} of the demonstration page.")
    paragraphs.extend(
        [
            ".SH LATER",
            "later-marker sits on the second screen.",
            ".SH SEE ALSO",
            ".BR cat (1)",
        ]
    )
    for index in range(14, 22):
        paragraphs.append(".PP")
        paragraphs.append(f"Trailing paragraph {index:02d} keeps the page from ending early.")
    (WORK / "demo.1").write_text("\n".join(paragraphs) + "\n", encoding="utf-8")

    tui_src = REPO / "scripts" / "terminal-corpus-mouse-tui.py"
    (WORK / "mouse_tui.py").write_bytes(tui_src.read_bytes())
    prepare_repo(env)
    prepare_crate(env)


def git(args: list[str], cwd: Path, env: dict[str, str], date: str | None = None) -> None:
    child = dict(env)
    if date is not None:
        child["GIT_AUTHOR_DATE"] = date
        child["GIT_COMMITTER_DATE"] = date
    run_cmd(["git", *args], cwd, child)


def prepare_repo(env: dict[str, str]) -> None:
    repo = WORK / "repo"
    repo.mkdir()
    git(["init", "-b", "main"], repo, env)
    long_subject = (
        "adjust the sample wording so this subject wraps on an eighty column "
        "screen but not on a wider one"
    )
    commits = [
        ("2026-01-10T12:00:00Z", "initial sample", "README.md", "sample repository\n"),
        ("2026-01-11T12:00:00Z", "add notes", "notes.txt", "some notes\n"),
    ]
    for date, message, name, body in commits:
        (repo / name).write_text(body, encoding="utf-8")
        git(["add", name], repo, env)
        git(["commit", "-m", message], repo, env, date)
    git(["checkout", "-b", "feature"], repo, env)
    (repo / "feature.txt").write_text("feature work\n", encoding="utf-8")
    git(["add", "feature.txt"], repo, env)
    git(["commit", "-m", "start feature"], repo, env, "2026-01-12T12:00:00Z")
    git(["checkout", "main"], repo, env)
    (repo / "more.txt").write_text("more sample text\n", encoding="utf-8")
    git(["add", "more.txt"], repo, env)
    git(["commit", "-m", long_subject], repo, env, "2026-01-13T12:00:00Z")
    git(
        ["merge", "--no-ff", "feature", "-m", "merge feature"],
        repo,
        env,
        "2026-01-14T12:00:00Z",
    )
    git(["tag", "v1.0.0"], repo, env)


def prepare_crate(env: dict[str, str]) -> None:
    crate = WORK / "errcrate"
    (crate / "src").mkdir(parents=True)
    (crate / "Cargo.toml").write_text(
        "[package]\nname = \"errcrate\"\nversion = \"0.1.0\"\nedition = \"2021\"\n",
        encoding="utf-8",
    )
    (crate / "src" / "main.rs").write_text(
        "fn main() {\n    let count: i32 = \"nope\";\n    println!(\"{count}\");\n}\n",
        encoding="utf-8",
    )
    cargo_home = HOME / "cargo-home"
    cargo_home.mkdir()
    target = crate / "target"
    target.mkdir()
    # Warm the compile once so the recorded run is the diagnostic, not a download.
    warm = dict(env)
    warm.update(cargo_env(cargo_home, target))
    subprocess.run(
        ["cargo", "build", "--offline", "--color=always"],
        cwd=crate,
        env=warm,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def cargo_env(cargo_home: Path, target: Path) -> dict[str, str]:
    rustup_home = os.environ.get("RUSTUP_HOME", str(Path.home() / ".rustup"))
    cargo_bin = str(Path.home() / ".cargo" / "bin")
    return {
        "PATH": cargo_bin + ":/usr/bin:/bin",
        "CARGO_HOME": str(cargo_home),
        "RUSTUP_HOME": rustup_home,
        "CARGO_TARGET_DIR": str(target),
        "CARGO_TERM_COLOR": "always",
        "CARGO_TERM_PROGRESS_WHEN": "never",
    }


def versions(env: dict[str, str]) -> dict[str, str]:
    cargo = dict(env)
    cargo.update(cargo_env(HOME / "cargo-home", WORK / "errcrate" / "target"))
    return {
        "python": first_line(["/usr/bin/python3", "--version"]),
        "bash": first_line(["/bin/bash", "--version"]),
        "ls": first_line(["/usr/bin/ls", "--version"]),
        "git": first_line(["/usr/bin/git", "--version"]),
        "nvim": first_line(["/usr/bin/nvim", "--version"]),
        "less": first_line(["/usr/bin/less", "--version"]),
        "man": first_line(["/usr/bin/man", "--version"]),
        "btop": first_line(["/usr/bin/btop", "--version"]),
        "tput": first_line(["/usr/bin/tput", "-V"]),
        "unshare": first_line(["/usr/bin/unshare", "--version"]),
        "cargo": first_line(["cargo", "--version"], cargo),
        "rustc": first_line(["rustc", "--version"], cargo),
    }


def build_scenarios(env: dict[str, str], info: dict[str, str]) -> list[Scenario]:
    ls_env = dict(env)
    ls_env["LS_COLORS"] = (
        "rs=0:di=01;34:ln=01;36:ex=01;32:or=40;31;01:*.rs=01;33:*.md=01;35:*.sh=01;32:*.txt=00"
    )
    cargo = dict(env)
    cargo.update(cargo_env(HOME / "cargo-home", WORK / "errcrate" / "target"))
    bash_argv = ["/bin/bash", "--noprofile", "--rcfile", str(HOME / "corpus.bashrc"), "-i"]
    bash_steps = [
        ("wait_contains", b"user@host", 5.0),
        ("wait_idle", 0.15),
        ("send", b"stty size\n"),
        ("wait_contains", b"stty size", 3.0),
        ("wait_idle", 0.15),
        ("send", b"echo hello-from-bash\n"),
        ("wait_contains", b"hello-from-bash", 3.0),
        ("wait_idle", 0.15),
        ("send", b"printf '\\033[31mred\\033[0m and \\033[32mgreen\\033[0m\\n'\n"),
        ("wait_contains", b"red", 3.0),
        ("wait_idle", 0.15),
        ("send", b"exit\n"),
        ("wait_exit", 3.0),
    ]
    git_argv = [
        "git",
        "--no-pager",
        "-c",
        "color.ui=always",
        "log",
        "--graph",
        "--color=always",
        "--decorate",
        "--all",
        "--date=short",
    ]
    nvim_argv = [
        "nvim",
        "--clean",
        "-c",
        "syntax enable|setfiletype rust|set noswapfile noundofile nomore shortmess+=I nowrap",
        "sample.rs",
    ]
    nvim_env = dict(env)
    nvim_env["NVIM_LOG_FILE"] = "/dev/null"
    mouse_steps = [
        ("wait_contains", b"READY", 5.0),
        ("send", b"\x1b[<0;10;4M"),
        ("wait_contains", b"MOUSE:press:", 3.0),
        ("send", b"\x1b[<0;10;4m"),
        ("wait_contains", b"MOUSE:release:", 3.0),
        ("send", b"\x1b[<32;15;5M"),
        ("wait_idle", 0.1),
        ("send", b"\x1b[200~hello paste\x1b[201~"),
        ("wait_contains", b"PASTE:hello paste", 3.0),
        ("send", b"q"),
        ("wait_exit", 3.0),
    ]
    items = [
        Scenario(
            name="bash-color",
            rows=24,
            cols=80,
            description="Interactive bash with a colored prompt, a size check, and a few commands.",
            program=info["bash"],
            argv=bash_argv,
            note="bashrc sets a fixed user@host prompt and clears PROMPT_COMMAND; it does not read the system bashrc.",
            expect=[b"hello-from-bash", b"24 80", b"\x1b[31mred", b"\x1b[?2004h"],
            env=env,
            cwd=WORK,
            steps=bash_steps,
            timeout=12,
        ),
        Scenario(
            name="bash-color-120x40",
            rows=40,
            cols=120,
            description="The same colored bash session at 120x40, so stty size reports the wider PTY.",
            program=info["bash"],
            argv=bash_argv,
            note="Same rcfile as bash-color.",
            expect=[b"hello-from-bash", b"40 120"],
            env=env,
            cwd=WORK,
            steps=bash_steps,
            timeout=12,
        ),
        Scenario(
            name="ls-color",
            rows=24,
            cols=80,
            description="ls --color of a small directory with a symlink, an executable, and an orphan link.",
            program=info["ls"],
            argv=["/usr/bin/ls", "--color=always", "-F"],
            note="LS_COLORS is set explicitly. Names are synthetic.",
            expect=[b"main.rs", b"run.sh", b"missing", b"\x1b["],
            env=ls_env,
            cwd=WORK / "listing",
            steps=[("wait_exit", 4.0)],
            timeout=6,
        ),
        Scenario(
            name="ls-color-120x40",
            rows=40,
            cols=120,
            description="The same colored ls at 120x40, where the names fit on fewer rows.",
            program=info["ls"],
            argv=["/usr/bin/ls", "--color=always", "-F"],
            note="Same directory and LS_COLORS as ls-color.",
            expect=[b"main.rs", b"very-long-sample-name.txt", b"\x1b["],
            env=ls_env,
            cwd=WORK / "listing",
            steps=[("wait_exit", 4.0)],
            timeout=6,
        ),
        Scenario(
            name="git-log",
            rows=24,
            cols=80,
            description="git log --graph --color --decorate of a synthetic repo with a merge and a tag.",
            program=info["git"],
            argv=git_argv,
            note="Commits use Ada Example <ada@example.com> and fixed dates. The long subject is one line; replay width decides the wrap.",
            expect=[b"Ada Example", b"merge feature", b"v1.0.0", b"\x1b["],
            env=env,
            cwd=WORK / "repo",
            steps=[("wait_exit", 5.0)],
            timeout=8,
        ),
        Scenario(
            name="nvim-edit",
            rows=24,
            cols=80,
            description="nvim --clean opens a file, pages down, inserts text, and quits the alternate screen.",
            program=info["nvim"],
            argv=nvim_argv,
            note="No user config, shada, or swap files. Syntax uses the system runtime.",
            expect=[b"Hello", b"sample line", b"\x1b[?1049h", b"\x1b[?1049l"],
            env=nvim_env,
            cwd=WORK,
            steps=[
                ("wait_contains", b"sample.rs", 12.0),
                ("wait_idle", 0.25),
                ("send", b"\x06"),
                ("wait_idle", 0.2),
                ("send", b"\x06"),
                ("wait_idle", 0.2),
                ("send", b"gg"),
                ("wait_idle", 0.2),
                ("send", b"iHello\x1b"),
                ("wait_contains", b"Hello", 4.0),
                ("wait_idle", 0.15),
                ("send", b":q!\r"),
                ("wait_exit", 4.0),
            ],
            timeout=20,
        ),
        Scenario(
            name="less-page",
            rows=24,
            cols=80,
            description="less pages a text file that contains color, unicode, and a wrapped line.",
            program=info["less"],
            argv=["/usr/bin/less", "-R", "page.txt"],
            note="LESSHISTFILE is /dev/null. One page-down, then quit.",
            expect=[b"TOP-MARKER", b"RED-MARKER", b"PAGE-TWO-MARKER", b"\x1b[?1049h"],
            env=env,
            cwd=WORK,
            steps=[
                ("wait_contains", b"TOP-MARKER", 5.0),
                ("wait_idle", 0.15),
                ("send", b" "),
                ("wait_contains", b"PAGE-TWO-MARKER", 3.0),
                ("send", b"q"),
                ("wait_exit", 3.0),
            ],
            timeout=10,
        ),
        Scenario(
            name="btop-sample",
            rows=24,
            cols=80,
            description="btop in tty mode for about two seconds, inside a fresh pid namespace.",
            program=f"{info['btop']}; {info['unshare']}",
            argv=[
                "unshare",
                "--user",
                "--map-root-user",
                "--pid",
                "--fork",
                "--mount-proc",
                "--",
                "btop",
                "-t",
                "-u",
                "1000",
            ],
            note=(
                "The pid namespace hides host processes. CPU model and memory "
                "total are replaced with same-width placeholders. The clock and "
                "per-core totals are live, so a re-record differs."
            ),
            expect=[b"btop", b"root", b"\x1b[?1049h"],
            env=env,
            cwd=WORK,
            steps=[
                ("wait_contains", b"btop", 6.0),
                ("sleep", 2.0),
                ("send", b"q"),
                ("wait_exit", 3.0),
            ],
            timeout=12,
        ),
        Scenario(
            name="man-demo",
            rows=24,
            cols=80,
            description="man displays a local demonstration page and less pages it once.",
            program=f"{info['man']}; pager {info['less']}",
            argv=["man", "-l", "-P", "less -R", "demo.1"],
            note="The page is written for the capture. It is not a system manual.",
            expect=[b"demo", b"later-marker", b"\x1b[?1049h"],
            env=env,
            cwd=WORK,
            steps=[
                ("wait_contains", b"DESCRIPTION", 8.0),
                ("wait_idle", 0.2),
                ("send", b" "),
                ("wait_contains", b"later-marker", 4.0),
                ("send", b"q"),
                ("wait_exit", 3.0),
            ],
            timeout=15,
        ),
        Scenario(
            name="python-repl",
            rows=24,
            cols=80,
            description="The system Python REPL prints a banner and evaluates a few expressions.",
            program=info["python"],
            argv=["/usr/bin/python3", "-i"],
            note="HOME is the capture home, so the REPL does not read a user startup file.",
            expect=[b"Python", b"hello-from-python", "café 😀 中文".encode(), b"sum=6"],
            env=env,
            cwd=WORK,
            steps=[
                ("wait_contains", b">>>", 5.0),
                ("send", b'print("hello-from-python")\n'),
                ("wait_contains", b"hello-from-python", 3.0),
                ("wait_contains", b">>>", 3.0),
                ("send", 'print("café 😀 中文")\n'.encode()),
                ("wait_contains", "中文".encode(), 3.0),
                ("wait_contains", b">>>", 3.0),
                ("send", b'print("sum=6")\n'),
                ("wait_contains", b"sum=6", 3.0),
