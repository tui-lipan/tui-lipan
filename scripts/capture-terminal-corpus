TPUT_SCRIPT = r"""
printf 'before-clear\n'
tput clear
tput cup 5 8
tput setaf 2
tput bold
printf 'green-bold'
tput sgr0
printf '\nplain\n'
tput smcup
printf 'on-alt-screen\n'
tput rmcup
printf 'after-alt\n'
tput reset
printf 'after-reset\n'
"""


def write_emitters() -> None:
    (WORK / "emit_unicode.py").write_text(
        textwrap.dedent(
            """\
            print("combining:", "e\\u0301", "precomposed:", "café")
            print("cjk:", "中文日本語한국어")
            print("emoji:", "😀", "heart:", "❤\\ufe0f", "zwj:", "👨\\u200d👩\\u200d👧")
            print("fullwidth:", "ＡＢＣ")
            print("boxes:", "┌──┐")
            print("tab\\tseparated")
            print("中" * 50)
            print("A" * 40 + "😀" * 8 + "文" * 20)
            """
        ),
        encoding="utf-8",
    )
    (WORK / "emit_long.py").write_text(
        textwrap.dedent(
            """\
            print("x" * 400)
            parts = []
            for index in range(24):
                color = 31 + (index % 6)
                parts.append(f"\\x1b[{color}m" + f"{index % 10}" * 10)
            parts.append("\\x1b[0m")
            print("".join(parts))
            print("字" * 80)
            print("START" + "y" * 180 + "\\x1b[0mEND")
            """
        ),
        encoding="utf-8",
    )
    (WORK / "emit_osc8.py").write_text(
        textwrap.dedent(
            """\
            def link(url, text, params=""):
                return f"\\x1b]8;{params};{url}\\x1b\\\\{text}\\x1b]8;;\\x1b\\\\"

            print("see " + link("https://example.com/docs", "the docs"))
            print(link("https://example.com/a", "alpha", "id=a1") + " and " + link("https://example.com/b", "beta"))
            print("bel " + "\\x1b]8;;https://example.com/bel\\x07" + "legacy" + "\\x1b]8;;\\x07")
            print(link("https://example.com/long", "L" * 100))
            """
        ),
        encoding="utf-8",
    )


def stop_process(pid: int) -> None:
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(pid, sig)
        except OSError:
            try:
                os.kill(pid, sig)
            except OSError:
                return
        time.sleep(0.05)


def drive(pid: int, master: int, steps: list[tuple], timeout: float) -> bytes:
    buf = bytearray()
    responder = Responder()
    fcntl.fcntl(master, fcntl.F_SETFL, fcntl.fcntl(master, fcntl.F_GETFL) | os.O_NONBLOCK)
    deadline = time.monotonic() + timeout
    index = 0
    idle_since: float | None = None
    step_started = time.monotonic()
    reaped = False

    def reap() -> bool:
        nonlocal reaped
        if reaped:
            return True
        done, _status = os.waitpid(pid, os.WNOHANG)
        if done:
            reaped = True
        return reaped

    def pull(wait: float) -> str:
        readable, _, _ = select.select([master], [], [], wait)
        if not readable:
            return "timeout"
        try:
            chunk = os.read(master, 65536)
        except OSError as exc:
            if exc.errno == errno.EIO:
                return "eof"
            raise
        if not chunk:
            return "eof"
        buf.extend(chunk)
        reply = responder.feed(chunk)
        if reply:
            try:
                os.write(master, reply)
            except OSError:
                pass
        return "data"

    try:
        while time.monotonic() < deadline:
            if index >= len(steps):
                kind = pull(0.1)
                if kind == "eof" or reap():
                    while pull(0.02) == "data":
                        pass
                    break
                continue
            step = steps[index]
            op = step[0]
            if op == "send":
                os.write(master, step[1])
                index += 1
                idle_since = None
                step_started = time.monotonic()
                continue
            if op == "sleep":
                end = time.monotonic() + step[1]
                while time.monotonic() < end:
                    if pull(0.05) == "eof":
                        break
                index += 1
                step_started = time.monotonic()
                continue
            if op == "wait_contains":
                needle, limit = step[1], step[2]
                if needle in buf:
                    index += 1
                    idle_since = None
                    step_started = time.monotonic()
                    continue
                if time.monotonic() - step_started > limit or pull(0.05) == "eof":
                    if needle not in buf:
                        raise CaptureError(f"missing {needle!r}")
                continue
            if op == "wait_idle":
                if idle_since is None:
                    idle_since = time.monotonic()
                if time.monotonic() - idle_since >= step[1]:
                    index += 1
                    idle_since = None
                    step_started = time.monotonic()
                    continue
                if pull(0.05) == "data":
                    idle_since = None
                continue
            if op == "wait_exit":
                if reap() or pull(0.05) == "eof":
                    while pull(0.02) == "data":
                        pass
                    reap()
                    index += 1
                    continue
                if time.monotonic() - step_started > step[1]:
                    raise CaptureError("process did not exit")
                continue
            raise CaptureError(f"unknown step {op}")
        else:
            raise CaptureError("timed out")
        if index < len(steps):
            raise CaptureError(f"stopped at step {index}: {steps[index][0]}")
        return bytes(buf)
    finally:
        if not reaped:
            stop_process(pid)
            try:
                os.waitpid(pid, 0)
            except OSError:
                pass
        os.close(master)


def spawn(scenario: Scenario) -> tuple[int, int]:
    winsize = struct.pack("HHHH", scenario.rows, scenario.cols, 0, 0)
    pid, master = pty.fork()
    if pid == 0:
        try:
            fcntl.ioctl(0, termios.TIOCSWINSZ, winsize)
            os.chdir(scenario.cwd)
            os.execvpe(scenario.argv[0], scenario.argv, scenario.env)
        except OSError as exc:
            os.write(2, f"exec failed: {exc}\n".encode())
            os._exit(127)
    fcntl.ioctl(master, termios.TIOCSWINSZ, winsize)
    return pid, master


def _command_output(argv: list[str]) -> str:
    try:
        result = subprocess.run(
            argv,
            cwd=REPO,
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError:
        return ""
    if result.returncode != 0:
        return ""
    return result.stdout.strip()


def deny_needles() -> tuple[bytes, ...]:
    """Identity strings for this machine, plus generic home-directory prefixes."""
    values: list[str] = []
    try:
        user = getpass.getuser()
    except OSError:
        user = ""
    if user:
        values.append(user)
    host = socket.gethostname()
    if host:
        values.append(host)
        short = host.split(".", 1)[0]
        if short and short != host:
            values.append(short)
    home = str(Path.home())
    if home:
        values.append(home)
    email = _command_output(["git", "config", "user.email"])
    if email:
        values.append(email)
    values.extend(("/home/", "/Users/"))
    needles: list[bytes] = []
    seen: set[bytes] = set()
    for value in values:
        value = value.strip()
        # A one-character needle matches almost every stream.
        if len(value) < 2:
            continue
        needle = value.encode()
        if needle in seen:
            continue
        seen.add(needle)
        needles.append(needle)
    return tuple(needles)


def _display_width(text: str) -> int:
    width = 0
    for char in text:
        if unicodedata.combining(char):
            continue
        width += 2 if unicodedata.east_asian_width(char) in {"W", "F"} else 1
    return width


def _same_width(text: str, stem: str) -> str:
    """ASCII placeholder with the same terminal columns as `text`."""
    width = _display_width(text)
    if width <= 0:
        return ""
    stem = "".join(char for char in stem if ord(char) < 128) or "x"
    if len(stem) > width:
        stem = stem[:width]
    fitted = stem + ("." * (width - len(stem)))
    if _display_width(fitted) != width:
        raise CaptureError(f"placeholder width mismatch for {width} columns")
    return fitted


def _zero_digits(text: str) -> str:
    return "".join("0" if char.isdigit() else char for char in text)


def _cpu_model() -> str:
    try:
        text = Path("/proc/cpuinfo").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""
    for line in text.splitlines():
        key, sep, value = line.partition(":")
        if sep and key.strip().lower() == "model name":
            return " ".join(value.split())
    return ""


def _cpu_forms(model: str) -> list[str]:
    """Contiguous word sequences that identify this CPU.

    Short tokens with no digit, such as a vendor name, are not specific enough
    to replace on their own. btop prints one of these sequences, not always the
    full model line.
    """
    words = model.split()
    forms: list[str] = []
    seen: set[str] = set()
    for length in range(len(words), 0, -1):
        for start in range(0, len(words) - length + 1):
            form = " ".join(words[start : start + length])
            if form in seen or len(form) < 4:
                continue
            if not any(char.isdigit() for char in form) and len(form) < 12:
                continue
            seen.add(form)
            forms.append(form)
    return forms


def _human_btop_v147(num_bytes: int, decimal: bool) -> str:
    """Size text btop 1.4.x prints for a byte count (not the shortened form)."""
    value = num_bytes * 100
    start = 0
    units = _DECIMAL_UNITS if decimal else _BINARY_UNITS
    if decimal:
        while value >= 100_000 and start < len(units) - 1:
            value //= 1000
            start += 1
    else:
        while value >= 102_400 and start < len(units) - 1:
            value >>= 10
            start += 1
    out = str(value)
    if not decimal and len(out) == 4 and start > 0:
        # Drop the extra hundredth, then put the decimal point two digits in.
        out = out[:2] + "." + out[2:-1]
    elif len(out) == 3 and start > 0:
        out = out[:1] + "." + out[1:]
    elif len(out) >= 2:
        out = out[:-2]
    if not out:
        out = "0"
    return f"{out} {units[start]}"


def _human_btop_float(num_bytes: int, decimal: bool) -> str:
    """Size text current btop prints for a byte count (not the shortened form)."""
    value = float(num_bytes)
    start = 0
    units = _DECIMAL_UNITS if decimal else _BINARY_UNITS
    limit = 999.5 if decimal else 1023.5
    base = 1000.0 if decimal else 1024.0
    while value >= limit and start < len(units) - 1:
        value /= base
        start += 1
    scaled = round(value * 10) / 10.0
    if scaled >= 99.95:
        rendered = f"{value:.0f}"
    elif round(value * 100) / 100.0 >= 9.995:
        rendered = f"{value:.1f}"
    else:
        rendered = f"{value:.2f}"
    return f"{rendered} {units[start]}"


def _meminfo_bytes(key: str) -> int | None:
    try:
        text = Path("/proc/meminfo").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    prefix = f"{key}:"
    for line in text.splitlines():
        if not line.startswith(prefix):
            continue
        parts = line.split()
        if len(parts) >= 2 and parts[1].isdigit():
            return int(parts[1]) << 10
    return None


def _memory_forms() -> list[str]:
    forms: list[str] = []
    seen: set[str] = set()
    for key in ("MemTotal", "SwapTotal"):
        num_bytes = _meminfo_bytes(key)
        if num_bytes is None or num_bytes <= 0:
            continue
        for decimal in (False, True):
            for form in (
                _human_btop_v147(num_bytes, decimal),
                _human_btop_float(num_bytes, decimal),
            ):
                if form in seen or len(form) < 4:
                    continue
                if not any(char.isdigit() and char != "0" for char in form):
                    continue
                seen.add(form)
                forms.append(form)
    return forms


def _host_forms() -> list[str]:
    host = socket.gethostname().strip()
    forms: list[str] = []
    if len(host) >= 4:
        forms.append(host)
    short = host.split(".", 1)[0]
    if len(short) >= 4 and short != host:
        forms.append(short)
    return forms


def _kernel_forms() -> list[str]:
    release = _command_output(["uname", "-r"])
    system = _command_output(["uname", "-s"])
    forms: list[str] = []
    if system and release:
        forms.append(f"{system} {release}")
    if len(release) >= 4:
        forms.append(release)
    return forms


def _hardware_pairs() -> list[tuple[bytes, bytes]]:
    labeled: list[tuple[str, str]] = []
    labeled.extend((form, _same_width(form, "Generic CPU")) for form in _cpu_forms(_cpu_model()))
    labeled.extend((form, _zero_digits(form)) for form in _memory_forms())
    labeled.extend((form, _same_width(form, "host")) for form in _host_forms())
    labeled.extend((form, _same_width(form, "generic-kernel")) for form in _kernel_forms())
    pairs: list[tuple[bytes, bytes]] = []
    seen: set[bytes] = set()
    for text, replacement in labeled:
        if _display_width(text) != _display_width(replacement):
            raise CaptureError(f"hardware placeholder width mismatch for {text!r}")
        needle = text.encode()
        if needle in seen or not needle:
            continue
        seen.add(needle)
        pairs.append((needle, replacement.encode()))
    pairs.sort(key=lambda item: len(item[0]), reverse=True)
    return pairs


def scrub_hardware(data: bytes) -> bytes:
    for needle, replacement in _hardware_pairs():
        if needle == replacement:
            continue
        data = data.replace(needle, replacement)
    return data


def _hit(name: str, data: bytes, needle: bytes, kind: str) -> str | None:
    at = data.find(needle)
    if at == -1:
        return None
    window = data[max(0, at - 40) : at + len(needle) + 40]
    return f"{name} contains {kind} {needle!r} near {window!r}"


def hardware_failure(name: str, data: bytes) -> str | None:
    for needle, _replacement in _hardware_pairs():
        problem = _hit(name, data, needle, "hardware id")
        if problem:
            return problem
    return None


def scrub_failure(name: str, data: bytes) -> str | None:
    for needle in deny_needles():
        problem = _hit(name, data, needle, "denied text")
        if problem:
            return problem
    return None


def source_text(scenario: Scenario) -> str:
    body = "\n".join(
        [
            f"command: scripts/capture-terminal-corpus {scenario.name}",
            f"tool: python pty capture ({sys.version.split()[0]}), winsize {scenario.rows}x{scenario.cols}",
            f"program: {scenario.program}",
            f"child: {command_line(scenario.argv)}",
            "TERM=xterm-256color COLORTERM=truecolor LANG=C.UTF-8",
            scenario.note,
        ]
    )
    return body.strip() + "\n"


def write_fixture(scenario: Scenario, data: bytes) -> None:
    data = scrub_hardware(data)
    source = source_text(scenario)
    blob = data + source.encode()
    problem = hardware_failure(scenario.name, blob) or scrub_failure(scenario.name, blob)
    if problem:
        raise CaptureError(problem)
    if len(data) > MAX_FIXTURE_BYTES:
        raise CaptureError(f"{scenario.name} is {len(data)} bytes")
    if not data:
        raise CaptureError(f"{scenario.name} is empty")
    for needle in scenario.expect:
        if needle not in data:
            raise CaptureError(f"{scenario.name} missing expected {needle!r}")
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    (OUT_DIR / f"{scenario.name}.vt").write_bytes(data)
    toml = "\n".join(
        [
            f"rows = {scenario.rows}",
            f"cols = {scenario.cols}",
            f"scrollback = {SCROLLBACK}",
            f"description = {toml_string(scenario.description)}",
            'source = """',
            toml_multiline_content(source.rstrip("\n")),
            '"""',
            "",
        ]
    )
    (OUT_DIR / f"{scenario.name}.toml").write_text(toml, encoding="utf-8")


def toml_multiline_content(value: str) -> str:
    # Basic TOML strings cannot contain raw controls, quotes or backslashes.
    return "".join(
        "\\\\" if char == "\\" else
        "\\\"" if char == '"' else
        f"\\u{ord(char):04X}" if (ord(char) < 32 and char not in "\n\t" or ord(char) == 127) else char
        for char in value
    )


def toml_string(value: str) -> str:
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def record(names: list[str] | None) -> int:
    env = base_env()
    print("preparing /tmp/w", flush=True)
    prepare_workspace(env)
    write_emitters()
    info = versions(env)
    chosen = build_scenarios(env, info)
    if names:
        wanted = set(names)
        known = {item.name for item in chosen}
        missing = wanted - known
        if missing:
            print("unknown fixture: " + ", ".join(sorted(missing)), file=sys.stderr)
            return 2
        chosen = [item for item in chosen if item.name in wanted]
    failures: list[str] = []
    for scenario in chosen:
        print(f"capture {scenario.name}", flush=True)
        pid, master = spawn(scenario)
        try:
            data = drive(pid, master, scenario.steps, scenario.timeout)
            write_fixture(scenario, data)
            print(f"  {len(data)} bytes", flush=True)
        except (CaptureError, OSError) as exc:
            failures.append(f"{scenario.name}: {exc}")
            print(f"  FAILED {exc}", file=sys.stderr, flush=True)
    if failures:
        print("failures:", file=sys.stderr)
        for item in failures:
            print(f"  {item}", file=sys.stderr)
        return 1
    return check()


def iter_fixtures() -> list[tuple[Path, Path]]:
    pairs: list[tuple[Path, Path]] = []
    if not OUT_DIR.is_dir():
        return pairs
    for vt in sorted(OUT_DIR.glob("*.vt")):
        pairs.append((vt, vt.with_suffix(".toml")))
    return pairs


def check() -> int:
    problems: list[str] = []
    pairs = iter_fixtures()
    if not pairs:
        problems.append("no fixtures in tests/fixtures/terminal-corpus")
    total = 0
    seen: set[str] = set()
    for vt, toml in pairs:
        seen.add(vt.name)
        data = vt.read_bytes()
        total += len(data)
        if len(data) > MAX_FIXTURE_BYTES:
            problems.append(f"{vt.name} is {len(data)} bytes")
        if not toml.is_file():
            problems.append(f"{vt.name} has no toml sidecar")
            continue
        text = toml.read_text(encoding="utf-8")
        total += len(text.encode())
        try:
            metadata = tomllib.loads(text)
        except tomllib.TOMLDecodeError as exc:
            problems.append(f"{toml.name} has invalid TOML: {exc}")
        else:
            for key in ("rows", "cols", "scrollback", "description", "source"):
                if key not in metadata:
                    problems.append(f"{toml.name} missing {key}")
        blob = data + text.encode()
        for problem in (hardware_failure(vt.name, blob), scrub_failure(vt.name, blob)):
            if problem:
                problems.append(problem)
    extras = [
        path.name
        for path in OUT_DIR.iterdir()
        if path.is_file() and path.suffix not in {".vt", ".toml", ".md"}
        and not path.name.endswith(".alacritty.json")
    ] if OUT_DIR.is_dir() else []
    for name in extras:
        problems.append(f"unexpected file {name}")
    if total > MAX_CORPUS_BYTES:
        problems.append(f"corpus is {total} bytes")
    if problems:
        print("terminal corpus check failed:", file=sys.stderr)
        for item in problems:
            print(f"  {item}", file=sys.stderr)
        return 1
    print(f"terminal corpus ok: {len(pairs)} fixtures, {total} bytes")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("names", nargs="*", help="fixture names to record; default is all")
    parser.add_argument("--check", action="store_true", help="scrub and size-check the fixtures")
    parser.add_argument("--list", action="store_true", help="list fixture names and exit")
    args = parser.parse_args()
    if args.check:
        return check()
    if args.list:
        env = base_env()
        # Listing must not need the prepared tree or a compiler.
        for scenario in build_scenarios(env, {key: key for key in (
            "bash", "ls", "git", "nvim", "less", "man", "btop", "unshare", "python", "cargo", "rustc", "tput"
        )}):
            print(f"{scenario.name}\t{scenario.cols}x{scenario.rows}")
        return 0
    return record(args.names)


if __name__ == "__main__":
    sys.exit(main())
