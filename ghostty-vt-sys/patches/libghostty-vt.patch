+/// tui-lipan patch: move the cursor to cell (x, y) of the active area
+/// without going through the VT parser. Unlike CUP it ignores origin mode
+/// and the margins. It clears a pending wrap and leaves the saved cursor and
+/// any unfinished escape sequence alone.
+pub fn tl_cursor_set(
+    terminal_: Terminal,
+    x: size.CellCountInt,
+    y: size.CellCountInt,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const t: *ZigTerminal = wrapper.terminal;
+    if (x >= t.cols or y >= t.rows) return .invalid_value;
+    t.screens.active.cursor.pending_wrap = false;
+    t.screens.active.cursorAbsolute(x, y);
+    return .success;
+}
+
+/// tui-lipan patch: erase from the cursor to the end of the active area,
+/// as ED 0 does, without going through the VT parser.
+pub fn tl_erase_below(terminal_: Terminal) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    wrapper.terminal.eraseDisplay(.below, false);
+    return .success;
+}
+
 pub fn reset(terminal_: Terminal) callconv(lib.calling_conv) void {
     const wrapper = terminal_ orelse return;
     const t: *ZigTerminal = wrapper.terminal;
